# Privy Configuration
# Get your app ID from https://dashboard.privy.io
NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id_here

# Flow AgentKit Configuration
# Get your API key from https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Flow Blockchain Configuration
FLOW_TESTNET_RPC_URL=https://testnet.evm.nodes.onflow.org
FLOW_MAINNET_RPC_URL=https://mainnet.evm.nodes.onflow.org
FLOW_PRIVATE_KEY=your_flow_private_key_here

# Agent Configuration
AGENT_MODEL=claude-3-5-haiku-20241022
AGENT_TEMPERATURE=0.1
AGENT_MAX_TOKENS=1000

# USD to FLOW conversion rate
USD_TO_FLOW_RATE=3

# Asset Marketplace Contract Address (deployed on Flow Testnet)
NEXT_PUBLIC_ASSET_MARKETPLACE_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Flow Network Configuration
NEXT_PUBLIC_FLOW_TESTNET_RPC=https://testnet.evm.nodes.onflow.org
NEXT_PUBLIC_FLOW_TESTNET_CHAIN_ID=545
# Firebase / Firestore (client, public web config)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Server-only: /api/firebase-token verifies the Privy access token and mints a
# Firebase custom token (uid = Privy DID). Never expose these to the client.
PRIVY_APP_ID=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
